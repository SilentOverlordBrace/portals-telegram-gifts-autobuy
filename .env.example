# ===== Telegram admin bot (aiogram) =====
# Bot token from @BotFather. Empty -> notifications print to stdout and the admin bot does not start.
BOT_TOKEN=
# Telegram user ids of the admins, comma-separated. Only they can use the bot and its buttons.
ADMIN_IDS=

# ===== Telegram account (Telethon): Mini App initData, Telegram's own gift valuation, /hunt link lookup =====
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Session file: data/<TG_SESSION_NAME>.session (created by `python -m portals_autobuy login`, chmod 600)
TG_SESSION_NAME=portals
# Portals bot and Mini App short name ("market" is taken from aportalsmp); the URL is the RequestWebView fallback
PORTALS_BOT_USERNAME=portals
PORTALS_APP_SHORT_NAME=market
PORTALS_WEBAPP_URL=https://portal-market.com
# Optional: initData pasted by hand (without the "tma " prefix). Telethon is then not needed, but it cannot refresh itself.
PORTALS_INIT_DATA=
# Seconds before initData is requested again (and right away on 401/403)
INIT_DATA_TTL=1800

# ===== Portals API =====
# NOTE: the domain is portal-market.com (no "s"); portals-market.com does not resolve
PORTALS_API_URL=https://portal-market.com/api
# Proxy for the API, e.g. http://user:pass@host:port (empty = no proxy)
HTTP_PROXY=
HTTP_TIMEOUT=15
# Client-side throttle, requests per second. The server sends x-ratelimit-limit: 2 on /nfts/search
REQUESTS_PER_SECOND=1.5
# Listings per request
SEARCH_LIMIT=20
# Cache of collection / attribute floors, seconds (also the floor snapshot cadence)
FLOORS_TTL=60

# ===== Safety and limits =====
# true = practice only (purchases are simulated and stored with the dry flag). A hard lock: no bot command
# (/dry off) and no stored setting can lift it. LIVE needs DRY_RUN=false here AND going live in the bot
# (/dry off, then its one-time Go-live button, or /dry off confirm), which arms LIVE for LIVE_ARM_HOURS only.
DRY_RUN=true
# Max all-in cost (fees included) of one gift, TON (hard ceiling above every rule). Limits are plain numbers:
# nan and inf are refused at startup.
MAX_PRICE_TON=10
# Budget for a rolling 24 hours, TON (all-in cost)
DAILY_BUDGET_TON=30
# Max buys in the last hour
MAX_BUYS_PER_HOUR=3
# LIVE switches back to practice by itself after this many hours (going live again renews it)
LIVE_ARM_HOURS=24
# Buys costing more than this always ask first, even in auto mode. 0 = half of the max price in force
# (MAX_PRICE_TON, or a lower /preset max)
CONFIRM_ABOVE_TON=0
# Breakers: pause a rule when its floor falls more than CRASH_PCT within 1 h (for CRASH_PAUSE_MIN minutes)
CRASH_PCT=20
CRASH_PAUSE_MIN=60
# Back to practice after LOSS_STREAK_N live buys in a row marked more than LOSS_STREAK_PCT below cost
LOSS_STREAK_N=3
LOSS_STREAK_PCT=10
# Pause when the balance (available + frozen) falls by more than the bot's own live spend plus this tolerance
BALANCE_GUARD=true
BALANCE_TOLERANCE_TON=0.5
# Pause after this many failed live buys in a row
AUTO_PAUSE_ERRORS=5
# Warn once when no cycle has succeeded for this many seconds
STALE_DATA_SEC=300
# /doctor warns when the market balance is above HOT_WALLET_WARN_X x DAILY_BUDGET_TON
HOT_WALLET_WARN_X=3

# ===== Fees (every price shown is net of them) =====
# TODO(verify): Portals fee schedule. Defaults are assumptions: guides say a 2.5-5% seller fee (the
# conservative 5% is used) and a 0.1 TON withdrawal fee. Collections flagged zero_commission on the
# public /api/collections get a 0% sell fee automatically.
BUY_FEE_PCT=0
SELL_FEE_PCT=5
WITHDRAW_FEE_TON=0.1
# Set to true once you have checked the fees; until then /status and the cards say "(unverified)"
FEES_VERIFIED=false

# ===== Honest floor and trap filter =====
# Cluster floor: lowest ask with at least CLUSTER_K other asks within CLUSTER_BAND_PCT above it.
# A floor without a cluster of at least 3 listings is always "low" confidence.
CLUSTER_K=2
CLUSTER_BAND_PCT=10
# Comparables needed for "high" confidence: collection-only rules / rules pinning model, backdrop or symbol
MIN_COMPARABLES_COLLECTION=5
MIN_COMPARABLES_ATTR=3
# Confidence drops one level when the floor moved more than this within 1 h
FLOOR_JUMP_PCT=25
# A price below this % of the floor is "too good to be true": alert only, never auto-bought
TOO_GOOD_PCT=25
# Retention of the observation tape, floor snapshots and the /why decision log, days
OBS_TTL_DAYS=14
SNAPSHOT_TTL_DAYS=14
DECISIONS_TTL_DAYS=7

# ===== Deal cards =====
# Seconds a confirm card waits for your tap
CONFIRM_TTL_SEC=90
# Silent "missed by a hair" card when exactly one numeric check fails by at most this % (max per hour)
NEAR_MISS_PCT=5
NEAR_MISS_MAX_PER_HOUR=3
# Hours of history the /hunt preview replays
PREVIEW_HOURS=24
# Show costs in your currency too: usd | none
DISPLAY_CURRENCY=usd

# ===== Second opinion: Telegram's valuation and your other markets =====
# Total time the candidates of one cycle may wait for these sources, seconds
PEERS_TIMEOUT_SEC=3
# payments.getUniqueStarGiftValueInfo via the Telethon session (cached, rate-limited)
TG_VALUE_ENABLED=true
TG_VALUE_TTL=600
TG_VALUE_MAX_PER_MIN=10
# Ask first when the floor has low confidence and the cost is above both Telegram's average and last sale
TG_VALUE_GUARD=true
# TON -> USD rate (keyless)
TON_RATE_URL=https://tonapi.io/v2/rates?tokens=ton&currencies=usd
TON_RATE_TTL=600
# Floor snapshot files written by other bots you run (MRKT, Tonnel), comma-separated,
# e.g. ../mrkt-autobuy/data/floors_mrkt.json
# This bot writes data/floors_portals.json for them (schema in the README; no secrets inside).
PEER_FLOOR_FILES=
# Ignore snapshot files older than this, seconds
PEER_MAX_AGE_SEC=600
# Ask first when the same gift is this % cheaper all-in on another market
CHEAPER_ELSEWHERE_PCT=3

# ===== Practice ledger, live gate and digest =====
# Practice positions are marked for this many days
PAPER_HORIZON_DAYS=7
# Marks reuse floor snapshots younger than this; otherwise at most MARK_MAX_QUERIES searches per pass
MARK_MAX_AGE_SEC=1800
MARK_MAX_QUERIES=10
MARK_INTERVAL_SEC=3600
# A rule is "ready" for live after GATE_MIN_TRADES practice buys within GATE_DAYS that are not losing
GATE_MIN_TRADES=5
GATE_DAYS=7
# Daily digest hour in local time (-1 = off)
DIGEST_HOUR=-1
# Your UTC offset in whole hours (0 = UTC, 3 = Moscow, -5 = New York in winter). It sets the times the bot
# shows (/why, /buys, /safety, /mute), DIGEST_HOUR, "Ignore today" and the daily error count
TZ_OFFSET_HOURS=0

# ===== Shadow rules, event log, optional LLM =====
# New rules from /addrule, /hunt and rules.json (entries without "state") start in shadow (practice only) until promoted
SHADOW_NEW_RULES=true
SHADOW_MIN_HOURS=24
SHADOW_MIN_MATCHES=5
SHADOW_MAX_HOURS=168
# A practice buy whose listing vanished within this many seconds counts as a race you probably lost
SNIPED_WINDOW_SEC=120
# JSON-lines event log (one event per line, format in the README) and its rotation size
EVENTS_FILE=data/events.jsonl
EVENTS_MAX_MB=20
# events.jsonl files of other bots you run, comma-separated; the digest adds an "Other bots" section
PEER_EVENT_FILES=
# Optional [Explain more] button (needs `pip install anthropic`); without a key no call is ever made
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== Engine =====
# Pause between cycles, seconds (exponential backoff up to MAX_BACKOFF on 429/errors)
POLL_INTERVAL=2
MAX_BACKOFF=60
# Optional rules file, loaded at every start (see rules.example.json); file rules keep their ids
RULES_FILE=rules.json
DATA_DIR=data
DB_FILE=portals_autobuy.db
# Days to remember listings already seen
SEEN_TTL_DAYS=7
LOG_LEVEL=INFO
